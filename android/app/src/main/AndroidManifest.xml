<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The only permission the app needs. It talks to one server — the user's own —
      and reads nothing from the device.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      androidx.media3-common declares ACCESS_NETWORK_STATE so its bandwidth meter can
      seed bitrate estimates for adaptive streaming. This app plays one progressive
      file at a time from one known server and never adapts, so it gains nothing.

      Removing it is safe rather than merely tidy: media3 wraps getActiveNetworkInfo()
      in a try/catch and degrades to an unknown network type when the permission is
      absent. Without this line, adding video playback would have quietly widened the
      app's permission set.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      media3 1.11 began declaring WAKE_LOCK so a background player can hold the CPU
      awake through a long track. Playback here is a short clip the user is looking
      at, in the foreground, in a screen they swipe away a second later — the screen
      is already on, and nothing plays once the app is not in front.

      Caught by the permission assertion in CI rather than by review, which is
      exactly the job that check exists to do.
    -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!--
      Login Flow v2 sends the user to their own Nextcloud in a browser, so the app
      needs to know a browser exists in order to hand it the URL.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PhotoSweep">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.PhotoSweep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
