{
	"name": "nissaar/photosweep",
	"description": "Go through your Nextcloud photo library one photo at a time",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Nissaar"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"doctrine/dbal": "^3.9",
		"nextcloud/coding-standard": "^1.3",
		"nextcloud/ocp": "^31.0",
		"phpunit/phpunit": "^13.0",
		"vimeo/psalm": "^5.26"
	},
	"autoload": {
		"psr-4": {
			"OCA\\PhotoSweep\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\PhotoSweep\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"scripts": {
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache",
		"test:unit": "phpunit --configuration tests/phpunit.xml"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		},
		"allow-plugins": {
			"composer/package-versions-deprecated": true
		}
	}
}
