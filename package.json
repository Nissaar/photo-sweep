{
  "name": "photosweep",
  "description": "Go through your Nextcloud photo library one photo at a time",
  "version": "1.0.1",
  "author": "Nissaar",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/files": "^4.1.0-beta.2",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.12.0",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@nextcloud/babel-config": "^1.2.0",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.1",
    "eslint": "^10.10.0",
    "minimizer-webpack-plugin": "^5.6.1",
    "node-polyfill-webpack-plugin": "4.0.0",
    "sass": "^1.83.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "vue-loader": "^17.4.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^20.11.0 || ^22 || ^24"
  }
}
